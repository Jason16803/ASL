{% extends "layout.twig" %}
{% block title %}Edit {{ planet.name }}{% endblock %}
{% block content %}

<div class="page-header">
  <h1>✏️ Edit Planet</h1>
  <a href="/planets/{{ planet.id }}" class="btn btn-secondary">← Back</a>
</div>

<div class="form-card">
  <form action="/planets/{{ planet.id }}" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="{{ planet.name }}" required>
    </div>
    <div class="form-group">
      <label for="size">Size (Earth radii)</label>
      <input type="number" id="size" name="size" value="{{ planet.size }}">
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description">{{ planet.description }}</textarea>
    </div>
    <div class="form-group">
      <label>Replace Image</label>
      {% if planet.imageUrl %}
        <img src="{{ planet.imageUrl }}" class="current-img" alt="Current image">
      {% endif %}
      <input type="file" id="image" name="image" accept="image/*">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/planets/{{ planet.id }}" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

{% endblock %}
