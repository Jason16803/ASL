{% extends "layout.twig" %}
{% block title %}Edit {{ star.name }}{% endblock %}
{% block content %}

<div class="page-header">
  <h1>✏️ Edit Star</h1>
  <a href="/stars/{{ star.id }}" class="btn btn-secondary">← Back</a>
</div>

<div class="form-card">
  <form action="/stars/{{ star.id }}" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="{{ star.name }}" required>
    </div>
    <div class="form-group">
      <label for="size">Size (solar radii)</label>
      <input type="number" id="size" name="size" value="{{ star.size }}">
    </div>
    <div class="form-group">
      <label for="GalaxyId">Galaxy</label>
      <select id="GalaxyId" name="GalaxyId">
        <option value="">— Select a galaxy —</option>
        {% for galaxy in galaxies %}
          <option value="{{ galaxy.id }}"
            {% if galaxy.id == star.GalaxyId %}selected{% endif %}>
            {{ galaxy.name }}
          </option>
        {% endfor %}
      </select>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description">{{ star.description }}</textarea>
    </div>
    <div class="form-group">
      <label>Replace Image</label>
      {% if star.imageUrl %}
        <img src="{{ star.imageUrl }}" class="current-img" alt="Current image">
      {% endif %}
      <input type="file" id="image" name="image" accept="image/*">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/stars/{{ star.id }}" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

{% endblock %}
